# For running the pipeline locally (GitHub Actions sets these itself).

DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5432/tracker
# Fernet key for the encrypted columns of the saved database:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=change-me
TIMEZONE=Asia/Kolkata

# AI. Each is optional: without a key, that part waits.
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-flash-latest
MISTRAL_API_KEY=
SUPABASE_SECRET_KEY=

# Where downloaded PDFs go during a run.
UPLOAD_DIR=/tmp/notifications

# Crawling. Keep the user agent free of "bot", URLs and e-mail addresses:
# upsc.gov.in's firewall rejects those with 403.
SCRAPER_USER_AGENT=ExamTracker/0.3 (personal exam tracker)
PER_HOST_MIN_INTERVAL_S=8
CRAWL_CONCURRENCY=3
FETCH_TIMEOUT_S=25
RESPECT_ROBOTS_TXT=true
